    <!-- Alert Custom Toast -->
    <div id="toast" class="fixed bottom-5 right-5 bg-slate-800 text-white border border-slate-700 px-4 py-3 rounded-xl shadow-xl hidden z-50 flex items-center gap-2">
        <i id="toastIcon" class="fa-solid fa-circle-info text-cyan-400"></i>
        <span id="toastMsg" class="text-sm"></span>
    </div>

    <script>
        // Diamond Packages Data
        const packages = [
            { id: 1, name: "115 Diamonds", price: 80, icon: "fa-gem" },
            { id: 2, name: "240 Diamonds", price: 160, icon: "fa-gem" },
            { id: 3, name: "355 Diamonds", price: 240, icon: "fa-gem" },
            { id: 4, name: "610 Diamonds", price: 400, icon: "fa-gem" },
            { id: 5, name: "1240 Diamonds", price: 800, icon: "fa-gem" },
            { id: 6, name: "Weekly Membership", price: 170, icon: "fa-crown" },
            { id: 7, name: "Monthly Membership", price: 780, icon: "fa-crown" }
        ];

        // Payment Phone Numbers
        const paymentNumbers = {
            bkash: "01711223344",
            nagad: "01811223344",
            rocket: "01911223344"
        };

        let selectedPkg = null;
        let selectedPayMethod = null;
        let ordersList = [];

        // Render Packages on Load
        window.onload = function() {
            const grid = document.getElementById('packageGrid');
            packages.forEach(pkg => {
                const card = document.createElement('div');
                card.className = `pkg-card border-2 border-slate-800 bg-slate-950 p-4 rounded-xl cursor-pointer transition-all hover:border-cyan-500/50 flex flex-col justify-between`;
                card.id = `pkg-${pkg.id}`;
                card.onclick = () => selectPackage(pkg);
                card.innerHTML = `
                    <div class="flex justify-between items-start mb-2">
                        <i class="fa-solid ${pkg.icon} text-cyan-400 text-lg"></i>
                        <span class="text-xs font-bold text-amber-400 bg-amber-400/10 border border-amber-400/20 px-2 py-0.5 rounded-full">৳${pkg.price}</span>
                    </div>
                    <h4 class="font-bold text-white text-sm sm:text-base">${pkg.name}</h4>
                `;
                grid.appendChild(card);
            });
        };

        // Select Diamond Package
        function selectPackage(pkg) {
            selectedPkg = pkg;
            document.querySelectorAll('.pkg-card').forEach(el => {
                el.classList.remove('border-cyan-400', 'bg-cyan-950/20', 'neon-glow');
                el.classList.add('border-slate-800', 'bg-slate-950');
            });
            const activeCard = document.getElementById(`pkg-${pkg.id}`);
            activeCard.classList.remove('border-slate-800', 'bg-slate-950');
            activeCard.classList.add('border-cyan-400', 'bg-cyan-950/20', 'neon-glow');

            if (selectedPayMethod) {
                document.getElementById('payAmount').innerText = `৳${pkg.price}`;
            }
        }

        // Select Payment Method
        function selectPayment(method) {
            selectedPayMethod = method;
            document.querySelectorAll('.pay-btn').forEach(btn => {
                btn.classList.remove('border-cyan-400', 'bg-slate-900');
            });

            const activeBtn = document.getElementById(`pay-${method}`);
            activeBtn.classList.add('border-cyan-400', 'bg-slate-900');

            const instDiv = document.getElementById('paymentInstructions');
            instDiv.classList.remove('hidden');

            document.getElementById('selectedMethodName').innerText = method.toUpperCase();
            document.getElementById('paymentNumber').innerText = paymentNumbers[method];
            document.getElementById('payAmount').innerText = selectedPkg ? `৳${selectedPkg.price}` : '৳০';
        }

        // Copy Phone Number
        function copyNumber() {
            const num = document.getElementById('paymentNumber').innerText;
            navigator.clipboard.writeText(num).then(() => {
                showToast("নম্বর কপি করা হয়েছে!");
            }).catch(() => {
                // Fallback for document copy
                const el = document.createElement('textarea');
                el.value = num;
                document.body.appendChild(el);
                el.select();
                document.execCommand('copy');
                document.body.removeChild(el);
                showToast("নম্বর কপি করা হয়েছে!");
            });
        }

        // Order Submit Logic
        function submitOrder() {
            const uidInput = document.getElementById('playerUid').value.trim();
            const trxInput = document.getElementById('trxIdInput').value.trim();
            const uidError = document.getElementById('uidError');

            // Validation
            if (!uidInput || uidInput.length < 8) {
                uidError.classList.remove('hidden');
                showToast("প্লেয়ার আইডি সঠিকভাবে পূরণ করুন!");
                return;
            } else {
                uidError.classList.add('hidden');
            }

            if (!selectedPkg) {
                showToast("একটি ডায়মন্ড প্যাকেজ সিলেক্ট করুন!");
                return;
            }

            if (!selectedPayMethod) {
                showToast("পেমেন্ট মেথড বেছে নিন!");
                return;
            }

            if (!trxInput) {
                showToast("ট্রানজেকশন আইডি (TrxID) প্রদান করুন!");
                return;
            }

            // Create Order Object
            const orderId = 'FF' + Math.floor(100000 + Math.random() * 900000);
            const newOrder = {
                id: orderId,
                uid: uidInput,
                packageName: selectedPkg.name,
                price: selectedPkg.price,
                method: selectedPayMethod.toUpperCase(),
                trxId: trxInput,
                status: 'Processing'
            };

            ordersList.push(newOrder);
            renderAdminOrders();

            // Populate Modal
            document.getElementById('modalOrderId').innerText = orderId;
            document.getElementById('modalUid').innerText = uidInput;
            document.getElementById('modalPackage').innerText = selectedPkg.name;
            document.getElementById('modalTrx').innerText = trxInput;

            // Show Confirmation Modal
            document.getElementById('orderModal').classList.remove('hidden');

            // Reset Input Fields
            document.getElementById('playerUid').value = '';
            document.getElementById('trxIdInput').value = '';
        }

        // Close Confirmation Modal
        function closeModal() {
            document.getElementById('orderModal').classList.add('hidden');
        }

        // Toggle Admin View
        function toggleAdminPanel() {
            const userSec = document.getElementById('userSection');
            const adminSec = document.getElementById('adminSection');
            const adminBtnText = document.getElementById('adminBtnText');

            if (adminSec.classList.contains('hidden')) {
                adminSec.classList.remove('hidden');
                userSec.classList.add('hidden');
                adminBtnText.innerText = "ইউজার মোড";
            } else {
                adminSec.classList.add('hidden');
                userSec.classList.remove('hidden');
                adminBtnText.innerText = "অ্যাডমিন মোড";
            }
        }

        // Render Admin Table
        function renderAdminOrders() {
            const tbody = document.getElementById('adminOrdersTable');
            const countText = document.getElementById('totalOrdersCount');
            tbody.innerHTML = '';
            countText.innerText = `মোট: ${ordersList.length}`;

            if(ordersList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-slate-500">কোনো অর্ডার জমা পড়েনি</td></tr>`;
                return;
            }

            ordersList.forEach(order => {
                const tr = document.createElement('tr');
                tr.className = 'border-b border-slate-800/60 hover:bg-slate-950/50';
                tr.innerHTML = `
                    <td class="p-3 font-mono text-cyan-400">${order.id}</td>
                    <td class="p-3 font-mono text-white">${order.uid}</td>
                    <td class="p-3">${order.packageName}</td>
                    <td class="p-3">${order.method}</td>
                    <td class="p-3 font-mono text-amber-400">${order.trxId}</td>
                    <td class="p-3">
                        <span class="bg-amber-400/10 text-amber-400 border border-amber-400/20 px-2 py-0.5 rounded text-[11px] font-bold">
                            ${order.status}
                        </span>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Toast Message Notification
        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            toastMsg.innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }
    </script>
</body>
</html>
